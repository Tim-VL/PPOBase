{% block ppobase_sales_report_by_item %}
<sw-page class="ppobase-sales-report">
    <template #content>
        <sw-card-view>
            <div class="ppobase-sales-report__search-bar">
                <sw-simple-search-field
                    v-model:value="searchTerm"
                    :placeholder="$tc('ppobase-sales-report.byItem.searchPlaceholder')"
                    :delay="350"
                    @search-term-change="onSearchTermChange">
                </sw-simple-search-field>

                <sw-card v-if="searchResults && searchResults.length">
                    <sw-data-grid
                        :dataSource="searchResults"
                        :columns="productColumns"
                        :showSelection="false"
                        :allowInlineEdit="false"
                        :isLoading="isSearching">
                        <template #column-product_name="{ item }">
                            <a class="ppobase-sales-report__link" @click.prevent="onSelectProduct(item)">{{ item.product_name }}</a>
                        </template>
                    </sw-data-grid>
                </sw-card>
            </div>

            <div class="ppobase-sales-report__date-filter">
                <sw-datepicker v-model:value="dateFrom" :label="$tc('ppobase-sales-report.common.labelDateFrom')" dateType="date" size="small"></sw-datepicker>
                <sw-datepicker v-model:value="dateTo" :label="$tc('ppobase-sales-report.common.labelDateTo')" dateType="date" size="small"></sw-datepicker>
                <sw-button variant="primary" size="small" @click="onApplyFilter">{{ $tc('ppobase-sales-report.common.buttonApply') }}</sw-button>
                <sw-button variant="ghost" size="small" @click="onResetFilter">{{ $tc('ppobase-sales-report.common.buttonReset') }}</sw-button>
            </div>

            <sw-empty-state v-if="!selectedProductId" :title="$tc('ppobase-sales-report.byItem.selectPrompt')"></sw-empty-state>

            <template v-else>
                <div class="ppobase-sales-report__product-info" v-if="report">
                    <div><strong>{{ report.product ? report.product.product_name : '-' }}</strong></div>
                    <div>{{ report.product ? (report.product.product_number || '-') : '-' }}</div>
                    <div>{{ $tc('ppobase-sales-report.byItem.labelTotalQty') }}: {{ report.summary ? report.summary.totalQuantity : 0 }}</div>
                    <div>{{ $tc('ppobase-sales-report.byItem.labelTotalRevenue') }}: {{ formatMoney(report.summary ? report.summary.totalRevenue : 0) }}</div>
                </div>

                <div class="ppobase-sales-report__chart-row" v-if="report && report.chartData">
                    <div class="ppobase-sales-report__chart-container">
                        <h4>{{ $tc('ppobase-sales-report.byItem.chartLineTitle') }}</h4>
                        <div style="position: relative; height: 350px; width: 100%;">
                            <canvas id="ppobase-sales-report-by-item-line"></canvas>
                        </div>
                    </div>
                    <div class="ppobase-sales-report__chart-container">
                        <h4>{{ $tc('ppobase-sales-report.byItem.chartBarTitle') }}</h4>
                        <div style="position: relative; height: 350px; width: 100%;">
                            <canvas id="ppobase-sales-report-by-item-bar"></canvas>
                        </div>
                    </div>
                </div>

                <sw-card :title="$tc('ppobase-sales-report.byItem.title')" :isLoading="isLoading">
                    <sw-data-grid
                        v-if="pagedGridOrders && pagedGridOrders.length"
                        :dataSource="pagedGridOrders"
                        :columns="orderColumns"
                        :showSelection="false"
                        :allowInlineEdit="false"
                        @column-sort="onColumnSort">
                        <template #column-order_number="{ item }">
                            <a class="ppobase-sales-report__link" @click.prevent="onOrderClick(item)">{{ item.order_number }}</a>
                        </template>
                        <template #column-order_date_time="{ item }">{{ formatDate(item.order_date_time) }}</template>
                        <template #column-unit_price="{ item }">{{ formatMoney(item.unit_price) }}</template>
                        <template #column-total_price="{ item }">{{ formatMoney(item.total_price) }}</template>
                    </sw-data-grid>

                    <sw-pagination
                        v-if="total > 0"
                        :page="page"
                        :limit="limit"
                        :total="total"
                        :steps="[10, 25, 50, 100]"
                        @page-change="onPageChange">
                    </sw-pagination>
                    <sw-empty-state v-else :title="$tc('ppobase-sales-report.byItem.emptyState')"></sw-empty-state>
                </sw-card>
            </template>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
