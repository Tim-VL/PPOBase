
{% block ppobase_supplier_form %}
<div class="ppobase-supplier-form">

    <!-- ==========================================
         BASIC INFORMATION CARD
         ========================================== -->
    {% block ppobase_supplier_form_basic_info %}
    <sw-card :title="$tc('ppobase-supplier.form.cardBasicInfo')">
        <sw-container columns="1fr 1fr 1fr" gap="0 30px">
            
            <sw-switch-field
                :label="$tc('ppobase-supplier.form.labelActive')"
                :helpText="$tc('ppobase-supplier.form.helpActive')"
                v-model:value="supplier.active"
                @change="emitChange">
            </sw-switch-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelSupplierNumber')"
                :helpText="$tc('ppobase-supplier.form.helpSupplierNumber')"
                v-model:value="supplier.supplierNumber"
                :disabled="!!supplier.id && !!supplier.supplierNumber"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelItemsIdRange')"
                :helpText="$tc('ppobase-supplier.form.helpItemsIdRange')"
                :placeholder="$tc('ppobase-supplier.form.placeholderItemsIdRange')"
                v-model:value="supplier.itemsIdRange"
                @change="emitChange">
            </sw-text-field>

        </sw-container>

        <sw-container columns="1fr 1fr" gap="0 30px">
            
            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelTradeName')"
                :helpText="$tc('ppobase-supplier.form.helpTradeName')"
                v-model:value="supplier.companyTradeName"
                :required="true"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelOfficialName')"
                :helpText="$tc('ppobase-supplier.form.helpOfficialName')"
                v-model:value="supplier.companyOfficialName"
                @change="emitChange">
            </sw-text-field>

        </sw-container>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         COMPANY DETAILS CARD
         ========================================== -->
    {% block ppobase_supplier_form_company_details %}
    <sw-card :title="$tc('ppobase-supplier.form.cardCompanyDetails')">
        <sw-container columns="1fr 1fr 1fr" gap="0 30px">
            
            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelCompanyNumber')"
                v-model:value="supplier.companyNumber"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelVatNumber')"
                v-model:value="supplier.vatNumber"
                @change="emitChange">
            </sw-text-field>

            <sw-number-field
                :label="$tc('ppobase-supplier.form.labelVatPercent')"
                :helpText="$tc('ppobase-supplier.form.helpVatPercent')"
                v-model:value="supplier.vatPercent"
                :min="0"
                :max="100"
                :step="0.01"
                @change="emitChange">
            </sw-number-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelTaxId')"
                v-model:value="supplier.taxId"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelExportNumber')"
                v-model:value="supplier.exportNumber"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelBusinessNumber')"
                v-model:value="supplier.businessNumber"
                @change="emitChange">
            </sw-text-field>

            <sw-email-field
                :label="$tc('ppobase-supplier.form.labelCompanyEmail')"
                :helpText="$tc('ppobase-supplier.form.helpCompanyEmail')"
                :required="true"
                v-model:value="supplier.companyEmail"
                @change="emitChange">
            </sw-email-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelWebsite')"
                :placeholder="$tc('ppobase-supplier.form.placeholderWebsite')"
                v-model:value="supplier.website"
                @change="emitChange">
            </sw-text-field>

        </sw-container>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         PRIMARY CONTACT CARD
         ========================================== -->
    {% block ppobase_supplier_form_primary_contact %}
    <sw-card :title="$tc('ppobase-supplier.form.cardPrimaryContact')">
        <sw-container columns="1fr 1fr" gap="0 30px">
            
            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelContactFirstName')"
                v-model:value="supplier.contactFirstName"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelContactLastName')"
                v-model:value="supplier.contactLastName"
                @change="emitChange">
            </sw-text-field>

            <sw-email-field
                :label="$tc('ppobase-supplier.form.labelContactEmail')"
                v-model:value="supplier.contactEmail"
                @change="emitChange">
            </sw-email-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelContactPhone')"
                v-model:value="supplier.contactPhone"
                @change="emitChange">
            </sw-text-field>

        </sw-container>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         GENERAL CONTACT CARD
         ========================================== -->
    {% block ppobase_supplier_form_general_contact %}
    <sw-card :title="$tc('ppobase-supplier.form.cardGeneralContact')">
        <sw-container columns="1fr 1fr" gap="0 30px">
            
            <sw-email-field
                :label="$tc('ppobase-supplier.form.labelGeneralEmail')"
                :helpText="$tc('ppobase-supplier.form.helpGeneralEmail')"
                v-model:value="supplier.generalEmail"
                @change="emitChange">
            </sw-email-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelGeneralPhone')"
                v-model:value="supplier.generalPhone"
                @change="emitChange">
            </sw-text-field>

            <sw-email-field
                :label="$tc('ppobase-supplier.form.labelPurchaseEmail')"
                :helpText="$tc('ppobase-supplier.form.helpPurchaseEmail')"
                v-model:value="supplier.purchaseEmail"
                @change="emitChange">
            </sw-email-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelDefaultCc')"
                :helpText="$tc('ppobase-supplier.form.helpDefaultCc')"
                :placeholder="$tc('ppobase-supplier.form.placeholderDefaultCc')"
                :error="ccError ? { detail: ccError } : null"
                v-model:value="supplier.defaultCc"
                @change="onCcChange(supplier.defaultCc)">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelDefaultBcc')"
                :helpText="$tc('ppobase-supplier.form.helpDefaultBcc')"
                :placeholder="$tc('ppobase-supplier.form.placeholderDefaultBcc')"
                :error="bccError ? { detail: bccError } : null"
                v-model:value="supplier.defaultBcc"
                @change="onBccChange(supplier.defaultBcc)">
            </sw-text-field>

        </sw-container>

        <sw-textarea-field
            :label="$tc('ppobase-supplier.form.labelNotes')"
            :placeholder="$tc('ppobase-supplier.form.placeholderNotes')"
            :modelValue="supplier.notes"
            @update:modelValue="onTextareaChange('notes', $event)">
        </sw-textarea-field>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         BILLING ADDRESS CARD
         ========================================== -->
    {% block ppobase_supplier_form_billing_address %}
    <sw-card :title="$tc('ppobase-supplier.form.cardBillingAddress')">
        <sw-container columns="1fr 1fr" gap="0 30px">
            
            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelAddressLine1')"
                v-model:value="supplier.billingAddressLine1"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelAddressLine2')"
                v-model:value="supplier.billingAddressLine2"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelCity')"
                v-model:value="supplier.billingCity"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelPostalCode')"
                v-model:value="supplier.billingPostalCode"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelCountry')"
                v-model:value="supplier.billingCountry"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelBillingContactPerson')"
                v-model:value="supplier.billingContactPerson"
                @change="emitChange">
            </sw-text-field>

            <sw-email-field
                :label="$tc('ppobase-supplier.form.labelBillingContactEmail')"
                v-model:value="supplier.billingContactEmail"
                @change="emitChange">
            </sw-email-field>

        </sw-container>

        <sw-textarea-field
            :label="$tc('ppobase-supplier.form.labelBillingNotes')"
            :modelValue="supplier.billingNotes"
            @update:modelValue="onTextareaChange('billingNotes', $event)">
        </sw-textarea-field>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         SHIPPING ADDRESS CARD
         ========================================== -->
    {% block ppobase_supplier_form_shipping_address %}
    <sw-card :title="$tc('ppobase-supplier.form.cardShippingAddress')">
        <sw-container columns="1fr 1fr" gap="0 30px">
            
            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelAddressLine1')"
                v-model:value="supplier.shippingAddressLine1"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelAddressLine2')"
                v-model:value="supplier.shippingAddressLine2"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelCity')"
                v-model:value="supplier.shippingCity"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelPostalCode')"
                v-model:value="supplier.shippingPostalCode"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelCountry')"
                v-model:value="supplier.shippingCountry"
                @change="emitChange">
            </sw-text-field>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelShippingContactPerson')"
                v-model:value="supplier.shippingContactPerson"
                @change="emitChange">
            </sw-text-field>

            <sw-email-field
                :label="$tc('ppobase-supplier.form.labelShippingContactEmail')"
                v-model:value="supplier.shippingContactEmail"
                @change="emitChange">
            </sw-email-field>

        </sw-container>

        <sw-textarea-field
            :label="$tc('ppobase-supplier.form.labelShippingNotes')"
            :modelValue="supplier.shippingNotes"
            @update:modelValue="onTextareaChange('shippingNotes', $event)">
        </sw-textarea-field>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         LOGISTICS CARD
         ========================================== -->
    {% block ppobase_supplier_form_logistics %}
    <sw-card :title="$tc('ppobase-supplier.form.cardLogistics')">
        <sw-container columns="1fr 1fr" gap="0 30px">
            
            <sw-number-field
                :label="$tc('ppobase-supplier.form.labelLeadTimeDays')"
                :helpText="$tc('ppobase-supplier.form.helpLeadTimeDays')"
                v-model:value="supplier.leadTimeDays"
                :min="0"
                @change="emitChange">
            </sw-number-field>

            <sw-multi-select
                :label="$tc('ppobase-supplier.form.labelDeliveryDays')"
                :helpText="$tc('ppobase-supplier.form.helpDeliveryDays')"
                :options="deliveryDaysOptions"
                v-model:value="selectedDeliveryDays"
                valueProperty="value"
                labelProperty="label">
            </sw-multi-select>

        </sw-container>
    </sw-card>
    {% endblock %}

    <!-- ==========================================
         COMMERCIAL CARD
         ========================================== -->
    {% block ppobase_supplier_form_commercial %}
    <sw-card :title="$tc('ppobase-supplier.form.cardCommercial')">
        <sw-container columns="1fr 1fr 1fr" gap="0 30px">
            
            <sw-single-select
                :label="$tc('ppobase-supplier.form.labelCurrency')"
                :options="currencyOptions"
                :required="true"
                v-model:value="supplier.currency"
                valueProperty="value"
                labelProperty="label"
                @change="emitChange">
            </sw-single-select>

            <sw-text-field
                :label="$tc('ppobase-supplier.form.labelPaymentTerms')"
                :helpText="$tc('ppobase-supplier.form.helpPaymentTerms')"
                :placeholder="$tc('ppobase-supplier.form.placeholderPaymentTerms')"
                v-model:value="supplier.paymentTerms"
                @change="emitChange">
            </sw-text-field>

            <sw-number-field
                :label="$tc('ppobase-supplier.form.labelMinimumOrderValue')"
                :helpText="$tc('ppobase-supplier.form.helpMinimumOrderValue')"
                v-model:value="supplier.minimumOrderValue"
                :min="0"
                :step="0.01"
                @change="emitChange">
            </sw-number-field>

            <sw-single-select
                :label="$tc('ppobase-supplier.form.labelIncoterms')"
                :helpText="$tc('ppobase-supplier.form.helpIncoterms')"
                :options="incotermsOptions"
                v-model:value="supplier.incoterms"
                valueProperty="value"
                labelProperty="label"
                @change="emitChange">
            </sw-single-select>

        </sw-container>

        <sw-textarea-field
            :label="$tc('ppobase-supplier.form.labelDiscountAgreements')"
            :helpText="$tc('ppobase-supplier.form.helpDiscountAgreements')"
            :placeholder="$tc('ppobase-supplier.form.placeholderDiscountAgreements')"
            :modelValue="supplier.discountAgreements"
            @update:modelValue="onTextareaChange('discountAgreements', $event)">
        </sw-textarea-field>
    </sw-card>
    {% endblock %}

</div>
{% endblock %}
